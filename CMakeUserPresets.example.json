{
  "version": 6,
  "configurePresets": [
    {
      "name": "local",
      "displayName": "release + local vcpkg cache",
      "description": "Copy to CMakeUserPresets.json (git-ignored) and replace <cache-root> with a folder on this machine. Build with: pwsh -File scripts/build.ps1 -Preset local",
      "inherits": "release",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "<cache-root>/installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=<cache-root>/bt;--x-packages-root=<cache-root>/pkg"
      }
    }
  ],
  "buildPresets": [
    { "name": "local", "configurePreset": "local" }
  ],
  "testPresets": [
    { "name": "local", "configurePreset": "local", "output": { "outputOnFailure": true } }
  ]
}
