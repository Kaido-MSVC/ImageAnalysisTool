{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "x64 static Release (MSVC 14.52)",
      "description": "Ninja and VCPKG_ROOT come from the environment (scripts/build.ps1 loads the MSVC developer environment, which sets VCPKG_ROOT to the Visual Studio bundled vcpkg). Machine-specific overrides go in CMakeUserPresets.json (see CMakeUserPresets.example.json).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_DISABLE_METRICS": "1"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-iat",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-iat"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
