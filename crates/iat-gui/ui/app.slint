// iat GUI。字串原文為英文，以 @tr() 包住；翻譯在 lang/<語系>/LC_MESSAGES/iat-gui.po（不使用預設翻譯 context）。
import { Button, ComboBox, ProgressIndicator, ListView, Slider, AboutSlint, Palette, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// 報告裡的固定狀態值（英文代碼）依介面語言顯示；報告與 JSON 本身維持原文。不認得的值照原文顯示。
export global Words {
    public pure function status(s: string) -> string {
        if (s == "equal") { return @tr("equal"); }
        if (s == "differs") { return @tr("differs"); }
        if (s == "not_comparable") { return @tr("not comparable"); }
        if (s == "not_compared") { return @tr("not compared"); }
        if (s == "incomplete") { return @tr("incomplete"); }
        if (s == "decode_incomplete") { return @tr("decode incomplete"); }
        if (s == "geometry_differs") { return @tr("geometry differs"); }
        if (s == "orientation_differs") { return @tr("orientation differs"); }
        if (s == "orientation_unparseable") { return @tr("orientation unparseable"); }
        if (s == "orientation_unknown") { return @tr("orientation unknown"); }
        if (s == "sample_model_changed") { return @tr("sample model changed"); }
        if (s == "bit_depth_changed") { return @tr("bit depth changed"); }
        if (s == "unknown") { return @tr("unknown"); }
        if (s == "unverified") { return @tr("unverified"); }
        if (s == "unreadable") { return @tr("unreadable"); }
        if (s == "missing_on_original") { return @tr("missing on original"); }
        if (s == "missing_on_output") { return @tr("missing on output"); }
        if (s == "both_absent") { return @tr("both absent"); }
        if (s == "both_synthesized") { return @tr("both synthesized"); }
        if (s == "synthesized_vs_absent") { return @tr("synthesized vs absent"); }
        if (s == "same") { return @tr("same"); }
        if (s == "changed") { return @tr("changed"); }
        if (s == "added") { return @tr("added"); }
        if (s == "removed") { return @tr("removed"); }
        if (s == "parse_failed") { return @tr("parse failed"); }
        if (s == "over_limit") { return @tr("over limit"); }
        if (s == "complete") { return @tr("complete"); }
        if (s == "partial") { return @tr("partial"); }
        if (s == "failed") { return @tr("failed"); }
        if (s == "not_checked") { return @tr("not checked"); }
        if (s == "unsupported") { return @tr("unsupported"); }
        if (s == "input_open_failed") { return @tr("input open failed"); }
        if (s == "environment_error") { return @tr("environment error"); }
        if (s == "unknown_format") { return @tr("unknown format"); }
        if (s == "format_not_supported_in_this_build") { return @tr("format not supported in this build"); }
        if (s == "match") { return @tr("match"); }
        if (s == "mismatch") { return @tr("mismatch"); }
        if (s == "indeterminate") { return @tr("indeterminate"); }
        if (s == "not_evaluated") { return @tr("not evaluated"); }
        if (s == "strict_match") { return @tr("strict match"); }
        if (s == "strict_mismatch") { return @tr("strict mismatch"); }
        if (s == "inspect_complete") { return @tr("inspect complete"); }
        if (s == "container_warning") { return @tr("container warning"); }
        if (s == "metadata_parse_failed") { return @tr("metadata parse failed"); }
        if (s == "metadata_over_limit") { return @tr("metadata over limit"); }
        if (s == "metadata_unverified") { return @tr("metadata unverified"); }
        if (s == "unsupported_or_not_checked") { return @tr("unsupported or not checked"); }
        if (s == "decode_or_structure_failure") { return @tr("decode or structure failure"); }
        if (s == "cancelled") { return @tr("cancelled"); }
        if (s == "deadline") { return @tr("deadline"); }
        if (s == "resource_limit") { return @tr("resource limit"); }
        if (s == "run_error") { return @tr("run error"); }
        if (s == "inspect_mode") { return @tr("inspect mode"); }
        return s;
    }

    // 色彩來源的白話說明（EffectiveColor.kind 與 Rust 端整理的細節）；只用於「像素一致」的說明行。
    public pure function color-source(kind: string, detail: string) -> string {
        if (kind == "none") { return @tr("no colour information"); }
        if (kind == "webp_default_srgb") { return @tr("sRGB (WebP default)"); }
        if (kind == "jxl_enum") { return detail == "" ? @tr("JPEG XL colour enum") : @tr("{} (JPEG XL colour enum)", detail); }
        if (kind == "srgb") { return @tr("sRGB (sRGB chunk)"); }
        if (kind == "chrm_gama" || kind == "partial") { return @tr("partial colour information ({})", detail); }
        if (kind == "cicp") { return @tr("CICP {}", detail); }
        if (kind == "icc") { return @tr("embedded ICC profile"); }
        if (kind == "icc_unreadable") { return @tr("unreadable ICC profile"); }
        if (kind == "tiff_colorimetry") { return @tr("TIFF colorimetry tags"); }
        return kind;
    }
}

export struct IssueRow {
    severity: string,
    code: string,
    scope: string,
    message: string,
}

export struct FileInfo {
    name: string,
    format: string,
    // 位元組數（十進位字串）
    size: string,
    // 例如 37×29；沒有尺寸時為空字串
    dims: string,
    decode-status: string,
    decode-reason: string,
}

export struct MetaRow {
    name: string,
    status: string,
}

// 結果摘要；狀態字串是報告裡的原值（英文代碼，與 JSON 相同），顯示時才經 Words 翻譯。
export struct ResultInfo {
    compare: bool,
    exit-code: int,
    exit-reason: string,
    strict: string,
    // strict 判定的原因代碼
    strict-reasons: [string],
    samples-status: string,
    samples-reason: string,
    color-status: string,
    // 判定依據的說明（英文自由文字，不翻譯）
    color-basis: string,
    // 狀態不是 same／both_absent 的 metadata 項目
    metadata: [MetaRow],
    original: FileInfo,
    output: FileInfo,
    run-id: string,
    // 「像素一致」：strict 無法判定、樣本相等、原因只有 color_unverified（只改 GUI 的呈現）
    pixel-identical: bool,
    // 色彩欄的依據（jxl_enum 已附上色彩空間名稱）
    color-text: string,
    color-original-kind: string,
    color-original-detail: string,
    color-output-kind: string,
    color-output-detail: string,
    // 報告 resource_need 的 job_commit_mib 建議值（MiB）；0 表示沒有
    suggested-mib: int,
    // 建議值超過目前可用的實體記憶體
    suggest-over-memory: bool,
    available-mib: int,
    // 這次是以建議值重新分析時用的 job_commit_mib（MiB）；0 表示不是
    raised-mib: int,
}

global Tone {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> good: dark ? #6ccb8a : #1b7a3d;
    out property <color> bad: dark ? #ff8a80 : #b3261e;
    out property <color> warn: dark ? #f0c05a : #8a5a00;
    // 介於 good 與 warn 之間：「像素一致」（樣本相同，只有色彩描述無法證明等價）
    out property <color> near: dark ? #bccf5e : #586d10;
    out property <color> muted: dark ? #a8a8a8 : #5f5f5f;
}

component SectionTitle inherits Text {
    font-size: 15px;
    font-weight: 600;
}

component Secondary inherits Text {
    color: Tone.muted;
    font-size: 12px;
}

// 一個輸入檔的拖放區。檔案從視窗任何位置拖入，依規則填入（見 Rust 端）；這裡只顯示狀態。
component FileSlot inherits Rectangle {
    in property <string> role;
    in property <string> hint;
    in property <string> name;
    in property <string> path;
    in property <bool> highlight;
    in property <bool> enabled: true;
    callback open();
    callback clear();

    min-height: 150px;
    border-radius: 8px;
    border-width: root.highlight ? 2px : 1px;
    border-color: root.highlight ? Palette.accent-background : Palette.border;
    background: Palette.alternate-background;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        SectionTitle { text: root.role; }
        Secondary { text: root.hint; wrap: word-wrap; }
        Rectangle { height: 4px; }
        if root.name == "": Text {
            text: @tr("Drop a file anywhere on the window, or choose one.");
            color: Tone.muted;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        if root.name != "": VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            Text { text: root.name; font-size: 14px; font-weight: 600; overflow: elide; }
            Secondary { text: root.path; overflow: elide; }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { text: @tr("Choose…"); enabled: root.enabled; clicked => { root.open(); } }
            Button { text: @tr("Clear"); enabled: root.enabled && root.name != ""; clicked => { root.clear(); } }
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    height: 32px;
    min-width: label.preferred-width + 24px;
    border-radius: 6px;
    background: root.selected ? Palette.accent-background : (ta.has-hover && root.enabled ? Palette.alternate-background : transparent);
    label := Text {
        text: root.text;
        color: root.selected ? Palette.accent-foreground : (root.enabled ? Palette.foreground : Tone.muted);
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component SelectPage inherits VerticalLayout {
    in property <string> original-name;
    in property <string> original-path;
    in property <string> output-name;
    in property <string> output-path;
    in property <bool> os-drag;
    callback open-original();
    callback open-output();
    callback clear-original();
    callback clear-output();
    callback swap();
    callback start();

    padding: 20px;
    spacing: 14px;
    Text {
        text: @tr("Choose the original and the converted file. With only the original, the file is inspected on its own.");
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 0;
        FileSlot {
            horizontal-stretch: 1;
            role: @tr("Original");
            hint: @tr("The reference file.");
            name: root.original-name;
            path: root.original-path;
            highlight: root.os-drag && root.original-name == "";
            open => { root.open-original(); }
            clear => { root.clear-original(); }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Swap");
                enabled: root.original-name != "" || root.output-name != "";
                clicked => { root.swap(); }
            }
        }
        FileSlot {
            horizontal-stretch: 1;
            role: @tr("Output");
            hint: @tr("The converted file to check against the original (optional).");
            name: root.output-name;
            path: root.output-path;
            highlight: root.os-drag && root.original-name != "";
            open => { root.open-output(); }
            clear => { root.clear-output(); }
        }
    }
    Secondary {
        text: @tr("Dropping two files fills Original and Output in drop order. A single file fills Original first, then Output.");
        wrap: word-wrap;
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        alignment: end;
        Button {
            text: root.output-name != "" ? @tr("Compare") : @tr("Inspect");
            primary: true;
            enabled: root.original-name != "";
            clicked => { root.start(); }
        }
    }
}

component RunPage inherits VerticalLayout {
    in property <int> stage;
    in property <float> progress;
    in property <bool> cancelling;
    callback cancel();

    padding: 40px;
    spacing: 14px;
    alignment: center;
    SectionTitle {
        text: root.stage == 0 ? @tr("Reading and hashing the inputs…") : @tr("Decoding and comparing…");
    }
    ProgressIndicator { progress: root.progress; height: 6px; }
    Secondary { text: @tr("{}%", round(root.progress * 100)); }
    HorizontalLayout {
        alignment: start;
        Button {
            text: root.cancelling ? @tr("Cancelling…") : @tr("Cancel");
            enabled: !root.cancelling;
            clicked => { root.cancel(); }
        }
    }
}

component Verdict inherits VerticalLayout {
    in property <ResultInfo> info;
    callback rerun-suggested();
    property <color> tone: info.pixel-identical ? Tone.near
        : info.exit-code == 0 ? Tone.good : info.exit-code == 1 || info.exit-code == 3 || info.exit-code == 5 ? Tone.bad : Tone.warn;
    spacing: 4px;
    Text {
        font-size: 22px;
        font-weight: 700;
        color: root.tone;
        text: info.pixel-identical ? @tr("Pixel identical")
            : info.exit-code == 0 ? (info.compare ? @tr("Strict match") : @tr("File is clean"))
            : info.exit-code == 1 ? @tr("Strict mismatch")
            : info.exit-code == 2 ? @tr("Indeterminate")
            : info.exit-code == 3 ? @tr("Decode or structure failure")
            : info.exit-code == 4 ? @tr("Not checked")
            : @tr("Run error");
    }
    Text {
        wrap: word-wrap;
        text: info.pixel-identical ? @tr("Every sample is identical. The two files describe their colour differently, so the tool cannot prove the colours are the same.")
            : info.exit-code == 0 ? (info.compare ? @tr("Samples, colour and metadata agree.") : @tr("The file decoded completely; container and metadata are valid."))
            : info.exit-code == 1 ? @tr("The files differ. See the reasons and issues below.")
            : info.exit-code == 2 ? @tr("The tool could not prove a match or a mismatch.")
            : info.exit-code == 3 ? @tr("At least one file is damaged or failed to decode.")
            : info.exit-code == 4 ? @tr("Stopped by a resource limit, the deadline or cancellation.")
            : @tr("An input could not be read, or the environment failed.");
    }
    if info.pixel-identical: Text {
        wrap: word-wrap;
        text: @tr("Colour source: original is {}; output is {}.",
            Words.color-source(info.color-original-kind, info.color-original-detail),
            Words.color-source(info.color-output-kind, info.color-output-detail));
    }
    Secondary { text: @tr("Exit code {} ({}) · strict: {}", info.exit-code, Words.status(info.exit-reason), Words.status(info.strict)); }
    if info.raised-mib > 0: Secondary { text: @tr("This run used the suggested memory limit: job_commit_mib = {} MiB.", info.raised-mib); }
    if info.suggested-mib > 0: HorizontalLayout {
        padding-top: 6px;
        spacing: 12px;
        alignment: start;
        Button {
            text: @tr("Re-analyze with the suggested value ({} MiB)", info.suggested-mib);
            clicked => { root.rerun-suggested(); }
        }
        if info.suggest-over-memory: Text {
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
            color: Tone.warn;
            text: @tr("More than the memory available now ({} MiB). The analysis may fail or slow down the computer.", info.available-mib);
        }
    }
}

component KeyValue inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 12px;
    Secondary { text: root.key; width: 110px; vertical-alignment: top; font-size: 13px; }
    Text { text: root.value == "" ? "—" : root.value; wrap: word-wrap; horizontal-stretch: 1; }
}

component FileLine inherits KeyValue {
    in property <FileInfo> file;
    property <string> decode: file.decode-status == "" ? "" : file.decode-reason == "" ? Words.status(file.decode-status)
        : Words.status(file.decode-status) + " (" + Words.status(file.decode-reason) + ")";
    value: file.name + "  " + (file.format == "" ? "" : file.format + " · ") + @tr("{} bytes", file.size)
        + (file.dims == "" ? "" : " · " + file.dims) + (decode == "" ? "" : " · " + @tr("decode {}", decode));
}

component ResultsPage inherits VerticalLayout {
    in property <ResultInfo> info;
    in property <[IssueRow]> issues;
    in property <int> export-status;
    in property <string> export-detail;
    callback export-json();
    callback export-md();
    callback view-images();
    callback new-run();
    callback rerun-suggested();

    padding: 20px;
    spacing: 12px;
    Verdict { info: root.info; rerun-suggested => { root.rerun-suggested(); } }
    VerticalLayout {
        spacing: 4px;
        FileLine { key: @tr("Original"); file: info.original; }
        if info.compare: FileLine { key: @tr("Output"); file: info.output; }
        if info.compare: KeyValue {
            key: @tr("Samples");
            value: info.samples-reason == "" ? Words.status(info.samples-status)
                : Words.status(info.samples-status) + " (" + Words.status(info.samples-reason) + ")";
        }
        if info.compare: KeyValue {
            key: @tr("Colour");
            value: info.color-text == "" ? Words.status(info.color-status) : Words.status(info.color-status) + " (" + info.color-text + ")";
        }
        if info.compare && info.metadata.length == 0: KeyValue { key: @tr("Metadata"); value: Words.status("same"); }
        if info.compare && info.metadata.length > 0: HorizontalLayout {
            spacing: 12px;
            Secondary { text: @tr("Metadata"); width: 110px; vertical-alignment: top; font-size: 13px; }
            VerticalLayout {
                horizontal-stretch: 1;
                for m in info.metadata: Text { text: m.name + ": " + Words.status(m.status); }
            }
        }
        if info.strict-reasons.length > 0: HorizontalLayout {
            spacing: 12px;
            Secondary { text: @tr("Reasons"); width: 110px; vertical-alignment: top; font-size: 13px; }
            VerticalLayout {
                horizontal-stretch: 1;
                for reason in info.strict-reasons: Text { text: Words.status(reason); }
            }
        }
    }
    SectionTitle { text: @tr("Issues ({})", root.issues.length); }
    Rectangle {
        vertical-stretch: 1;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 6px;
        if root.issues.length == 0: Secondary {
            text: @tr("No issues were reported.");
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ListView {
            for row in root.issues: HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;
                Text {
                    width: 64px;
                    font-weight: 600;
                    color: row.severity == "error" ? Tone.bad : row.severity == "warning" ? Tone.warn : Tone.muted;
                    text: row.severity == "error" ? @tr("Error") : row.severity == "warning" ? @tr("Warning") : @tr("Info");
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    // 取消：畫面上換成翻譯過的說明（報告裡仍是 core 的原文）
                    Secondary { text: (row.code == "cancelled" ? @tr("Cancelled") : row.code) + " · " + row.scope; }
                    Text { text: row.code == "cancelled" ? @tr("The analysis was cancelled.") : row.message; wrap: word-wrap; }
                }
            }
        }
    }
    if root.export-status != 0: Text {
        wrap: word-wrap;
        color: root.export-status == 1 ? Tone.good : Tone.bad;
        text: root.export-status == 1 ? @tr("Report saved: {}", root.export-detail)
            : root.export-status == 2 ? @tr("A file with this name already exists and is never overwritten. Choose a different file name: {}", root.export-detail)
            : root.export-status == 3 ? @tr("The report cannot replace one of the input files. Choose a different file name: {}", root.export-detail)
            : root.export-status == 4 ? @tr("The folder does not exist: {}", root.export-detail)
            : @tr("The report could not be saved: {}", root.export-detail);
    }
    HorizontalLayout {
        spacing: 8px;
        Button { text: @tr("Export JSON…"); clicked => { root.export-json(); } }
        Button { text: @tr("Export Markdown…"); clicked => { root.export-md(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("View images"); clicked => { root.view-images(); } }
        Button { text: @tr("New comparison"); primary: true; clicked => { root.new-run(); } }
    }
}

component ViewerPage inherits VerticalLayout {
    // 0 未載入、1 載入中、2 可檢視、3 錯誤
    in property <int> state;
    in property <string> error-text;
    // 1：超過檢視上限（error-text 為尺寸）
    in property <int> error-kind;
    in property <bool> has-output;
    // 0 可用、1 尺寸不同、2 只有一個檔案
    in property <int> diff-state;
    // 顯示用金字塔：第 0 層原尺寸，之後每層減半
    in property <[image]> img-original;
    in property <[image]> img-output;
    in property <[image]> img-diff;
    in property <string> probe-text;
    in property <string> info-text;
    in-out property <int> mode;
    in-out property <float> zoom: 1;
    // 每次載入新影像時加一：檢視會自動符合視窗
    in property <int> fit-token;
    callback probe(int, int);
    changed fit-token => { root.fit(); }

    property <[image]> levels: root.mode == 0 ? root.img-original : root.mode == 1 ? root.img-output : root.img-diff;
    // 原尺寸層決定座標與大小；畫面上只換來源，100% 以上一律用原尺寸層
    property <image> current: root.levels[0];
    property <int> level: min(root.levels.length - 1, root.level-for(root.zoom));
    property <image> shown: root.levels[max(0, root.level)];

    // 縮放比例 z < 1 時取 2^-k ≥ z 的最小層，也就是 k = floor(log2(1/z))
    pure function level-for(z: float) -> int {
        if (z >= 1) { return 0; }
        let k = floor(log(1 / z, 2));
        return max(0, k);
    }
    property <int> hover-x: ta.has-hover ? floor(ta.mouse-x / (root.zoom * 1px)) : -1;
    property <int> hover-y: ta.has-hover ? floor(ta.mouse-y / (root.zoom * 1px)) : -1;
    changed hover-x => { root.probe(root.hover-x, root.hover-y); }
    changed hover-y => { root.probe(root.hover-x, root.hover-y); }

    function fit() {
        if (root.current.width > 0 && root.current.height > 0) {
            root.zoom = clamp(min(flick.width / (root.current.width * 1px), flick.height / (root.current.height * 1px)), 0.02, 16);
        }
    }

    padding: 12px;
    spacing: 8px;
    HorizontalLayout {
        spacing: 6px;
        NavButton { text: @tr("Original"); selected: root.mode == 0; clicked => { root.mode = 0; } }
        NavButton { text: @tr("Output"); selected: root.mode == 1; enabled: root.has-output; clicked => { root.mode = 1; } }
        NavButton { text: @tr("Difference"); selected: root.mode == 2; enabled: root.diff-state == 0; clicked => { root.mode = 2; } }
        Rectangle { width: 12px; }
        Button { text: @tr("Fit"); clicked => { root.fit(); } }
        Button { text: "100%"; clicked => { root.zoom = 1; } }
        Slider { minimum: 0.02; maximum: 16; value <=> root.zoom; min-width: 160px; }
        Text { text: round(root.zoom * 100) + "%"; vertical-alignment: center; min-width: 48px; }
        Rectangle { horizontal-stretch: 1; }
        Secondary { text: @tr("ICC not applied"); vertical-alignment: center; }
    }
    Rectangle {
        vertical-stretch: 1;
        background: Tone.dark ? #1b1b1b : #e6e6e6;
        border-radius: 6px;
        clip: true;
        flick := Flickable {
            content-width: max(self.width, root.current.width * 1px * root.zoom);
            content-height: max(self.height, root.current.height * 1px * root.zoom);
            Image {
                x: 0;
                y: 0;
                source: root.shown;
                width: root.current.width * 1px * root.zoom;
                height: root.current.height * 1px * root.zoom;
                image-rendering: root.zoom >= 2 ? pixelated : smooth;
                ta := TouchArea {
                    scroll-event(e) => {
                        if (e.modifiers.control) {
                            root.zoom = clamp(root.zoom * (e.delta-y > 0 ? 1.25 : 0.8), 0.02, 16);
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
        if root.state != 2: Rectangle {
            background: Tone.dark ? #1b1b1b : #e6e6e6;
            Text {
                text: root.state == 1 ? @tr("Decoding the images for viewing…")
                    : root.state == 3 && root.error-kind == 1 ? @tr("This image ({}) is too large to view. The result and the report export are not affected.", root.error-text)
                    : root.state == 3 ? @tr("The images cannot be shown: {}", root.error-text) : "";
                color: root.state == 3 ? Tone.bad : Tone.muted;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    if root.mode == 2: Secondary {
        text: @tr("Difference: black means equal; red to yellow to white shows the largest channel difference (log scale).");
        wrap: word-wrap;
    }
    if root.diff-state == 1: Secondary { text: @tr("The images have different dimensions, so no difference map is shown."); }
    if root.diff-state == 3: Secondary { text: @tr("The images use different sample models or bit depths, so no difference map is shown."); }
    HorizontalLayout {
        spacing: 16px;
        Text { text: root.probe-text; font-family: "Consolas"; horizontal-stretch: 1; overflow: elide; }
        Secondary { text: root.info-text; }
    }
}

component AboutPage inherits VerticalLayout {
    in property <string> version;
    padding: 24px;
    spacing: 10px;
    Text { text: "iat " + root.version; font-size: 22px; font-weight: 700; }
    Text {
        text: @tr("Image Analysis Tool checks whether a converted image keeps every sample, colour signal and piece of metadata of the original.");
        wrap: word-wrap;
    }
    Secondary { text: @tr("Licensed under the MIT License. Reports are never overwritten; input files are opened read-only."); wrap: word-wrap; }
    Rectangle { height: 8px; }
    HorizontalLayout {
        alignment: start;
        AboutSlint { }
    }
    Rectangle { vertical-stretch: 1; }
}

export component AppWindow inherits Window {
    title: "iat";
    // 256×256 取自 iat-rust.ico（assets/icons/extract_ico_png.py），標題列與工作列用
    icon: @image-url("../../../assets/icons/iat-rust-256.png");
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 560px;

    // 0 English、1 繁體中文、2 日本語
    in-out property <int> language;
    default-font-family: root.language == 1 ? "Microsoft JhengHei UI" : root.language == 2 ? "Yu Gothic UI" : "Segoe UI";

    in property <string> version;
    // 0 選檔、1 執行中、2 結果、3 影像、4 關於
    in-out property <int> page;
    in property <bool> os-drag;
    in property <string> original-name;
    in property <string> original-path;
    in property <string> output-name;
    in property <string> output-path;

    in property <int> stage;
    in property <float> progress;
    in property <bool> cancelling;

    in property <bool> has-result;
    in property <ResultInfo> result;
    in property <[IssueRow]> issues;
    in property <int> export-status;
    in property <string> export-detail;

    in property <int> view-state;
    in property <string> view-error;
    in property <int> view-error-kind;
    in property <bool> view-has-output;
    in property <int> view-diff-state;
    in property <[image]> img-original;
    in property <[image]> img-output;
    in property <[image]> img-diff;
    in property <string> probe-text;
    in property <string> view-info;
    in-out property <int> view-mode;
    in-out property <float> view-zoom: 1;
    in property <int> view-fit-token;

    callback language-selected(int);
    callback open-original();
    callback open-output();
    callback clear-original();
    callback clear-output();
    callback swap();
    callback start();
    callback cancel();
    callback export-json();
    callback export-md();
    callback enter-viewer();
    callback probe(int, int);
    callback rerun-suggested();

    VerticalLayout {
        Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 8px;
                padding-left: 14px;
                spacing: 4px;
                Text { text: "iat"; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 14px; }
                NavButton { text: @tr("Files"); selected: root.page == 0; enabled: root.page != 1; clicked => { root.page = 0; } }
                NavButton { text: @tr("Results"); selected: root.page == 2; enabled: root.page != 1 && root.has-result; clicked => { root.page = 2; } }
                NavButton {
                    text: @tr("Images");
                    selected: root.page == 3;
                    enabled: root.page != 1 && root.has-result;
                    clicked => { root.page = 3; root.enter-viewer(); }
                }
                NavButton { text: @tr("About"); selected: root.page == 4; enabled: root.page != 1; clicked => { root.page = 4; } }
                Rectangle { horizontal-stretch: 1; }
                ComboBox {
                    width: 150px;
                    model: ["English", "繁體中文", "日本語"];
                    current-index: root.language;
                    selected => { root.language = self.current-index; root.language-selected(self.current-index); }
                }
            }
        }
        if root.page == 0: SelectPage {
            vertical-stretch: 1;
            original-name: root.original-name;
            original-path: root.original-path;
            output-name: root.output-name;
            output-path: root.output-path;
            os-drag: root.os-drag;
            open-original => { root.open-original(); }
            open-output => { root.open-output(); }
            clear-original => { root.clear-original(); }
            clear-output => { root.clear-output(); }
            swap => { root.swap(); }
            start => { root.start(); }
        }
        if root.page == 1: RunPage {
            vertical-stretch: 1;
            stage: root.stage;
            progress: root.progress;
            cancelling: root.cancelling;
            cancel => { root.cancel(); }
        }
        if root.page == 2: ResultsPage {
            vertical-stretch: 1;
            info: root.result;
            issues: root.issues;
            export-status: root.export-status;
            export-detail: root.export-detail;
            export-json => { root.export-json(); }
            export-md => { root.export-md(); }
            view-images => { root.page = 3; root.enter-viewer(); }
            new-run => { root.page = 0; }
            rerun-suggested => { root.rerun-suggested(); }
        }
        if root.page == 3: ViewerPage {
            vertical-stretch: 1;
            state: root.view-state;
            error-text: root.view-error;
            error-kind: root.view-error-kind;
            has-output: root.view-has-output;
            diff-state: root.view-diff-state;
            img-original: root.img-original;
            img-output: root.img-output;
            img-diff: root.img-diff;
            probe-text: root.probe-text;
            info-text: root.view-info;
            mode <=> root.view-mode;
            fit-token: root.view-fit-token;
            zoom <=> root.view-zoom;
            probe(x, y) => { root.probe(x, y); }
        }
        if root.page == 4: AboutPage {
            vertical-stretch: 1;
            version: root.version;
        }
    }
}
