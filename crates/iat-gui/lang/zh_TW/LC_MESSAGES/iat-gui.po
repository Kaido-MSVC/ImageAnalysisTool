msgstr "檢查完成"

msgid "container warning"
msgstr "容器有警告"

msgid "metadata parse failed"
msgstr "中繼資料解析失敗"

msgid "metadata over limit"
msgstr "中繼資料超過上限"

msgid "metadata unverified"
msgstr "中繼資料未驗證"

