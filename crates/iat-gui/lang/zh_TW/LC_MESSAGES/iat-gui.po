# iat-gui 繁體中文（台灣）翻譯。原文在 crates/iat-gui/ui/app.slint；用 lang/check_po.py 檢查是否齊全。
msgid ""
msgstr ""
"Language: zh_TW\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Drop a file anywhere on the window, or choose one."
msgstr "把檔案拖到視窗任何位置，或按「選擇…」。"

msgid "Choose…"
msgstr "選擇…"

msgid "Clear"
msgstr "清除"

msgid "Choose the original and the converted file. With only the original, the file is inspected on its own."
msgstr "選擇原檔與轉換後的檔案。只有原檔時，會單獨檢查這個檔案。"

msgid "Original"
msgstr "原檔"

msgid "The reference file."
msgstr "作為基準的檔案。"

msgid "Swap"
msgstr "對調"

msgid "Output"
msgstr "輸出檔"

msgid "The converted file to check against the original (optional)."
msgstr "要和原檔比對的轉換結果（可省略）。"

msgid "Dropping two files fills Original and Output in drop order. A single file fills Original first, then Output."
msgstr "一次拖入兩個檔案時，依拖入順序填入原檔與輸出檔。只拖入一個時先填原檔，原檔已有則填輸出檔。"

msgid "Compare"
msgstr "比對"

msgid "Inspect"
msgstr "檢查"

msgid "Reading and hashing the inputs…"
msgstr "正在讀取輸入檔並計算雜湊…"

msgid "Decoding and comparing…"
msgstr "正在解碼與比對…"

msgid "{}%"
msgstr "{}%"

msgid "Cancelling…"
msgstr "正在取消…"

msgid "Cancel"
msgstr "取消"

msgid "Strict match"
msgstr "嚴格一致"

msgid "File is clean"
msgstr "檔案正常"

msgid "Strict mismatch"
msgstr "嚴格不一致"

msgid "Indeterminate"
msgstr "無法判定"

msgid "Decode or structure failure"
msgstr "解碼或結構失敗"

msgid "Not checked"
msgstr "未檢查"

msgid "Run error"
msgstr "執行錯誤"

msgid "Samples, colour and metadata agree."
msgstr "樣本、色彩與中繼資料都一致。"

msgid "The file decoded completely; container and metadata are valid."
msgstr "檔案完整解碼，容器與中繼資料都有效。"

msgid "The files differ. See the reasons and issues below."
msgstr "兩個檔案不同，原因與問題列在下方。"

msgid "The tool could not prove a match or a mismatch."
msgstr "無法證明一致，也無法證明不一致。"

msgid "At least one file is damaged or failed to decode."
msgstr "至少有一個檔案損壞或解碼失敗。"

msgid "Stopped by a resource limit, the deadline or cancellation."
msgstr "因資源上限、時間期限或取消而停止。"

msgid "An input could not be read, or the environment failed."
msgstr "無法讀取輸入檔，或執行環境發生錯誤。"

msgid "Exit code {} ({}) · strict: {}"
msgstr "退出碼 {}（{}）· strict：{}"

msgid "Samples"
msgstr "樣本"

msgid "Colour"
msgstr "色彩"

msgid "Metadata"
msgstr "中繼資料"

msgid "Reasons"
msgstr "原因"

msgid "Issues ({})"
msgstr "問題（{}）"

msgid "No issues were reported."
msgstr "沒有回報任何問題。"

msgid "Error"
msgstr "錯誤"

msgid "Warning"
msgstr "警告"

msgid "Info"
msgstr "資訊"

msgid "Report saved: {}"
msgstr "報告已儲存：{}"

msgid "A file with this name already exists and is never overwritten. Choose a different file name: {}"
msgstr "已有同名檔案，報告絕不覆寫。請另選檔名：{}"

msgid "The report cannot replace one of the input files. Choose a different file name: {}"
msgstr "報告不能取代輸入檔。請另選檔名：{}"

msgid "The folder does not exist: {}"
msgstr "資料夾不存在：{}"

msgid "The report could not be saved: {}"
msgstr "無法儲存報告：{}"

msgid "Export JSON…"
msgstr "匯出 JSON…"

msgid "Export Markdown…"
msgstr "匯出 Markdown…"

msgid "View images"
msgstr "檢視影像"

msgid "New comparison"
msgstr "重新選檔"

msgid "Difference"
msgstr "差異"

msgid "Fit"
msgstr "符合視窗"

msgid "ICC not applied"
msgstr "未套用 ICC"

msgid "Decoding the images for viewing…"
msgstr "正在解碼影像以供檢視…"

msgid "The images cannot be shown: {}"
msgstr "無法顯示影像：{}"

msgid "Difference: black means equal; red to yellow to white shows the largest channel difference (log scale)."
msgstr "差異：黑色表示相同；由紅、黃到白表示各聲道中最大的差值（對數比例）。"

msgid "The images have different dimensions, so no difference map is shown."
msgstr "兩張影像的尺寸不同，因此不顯示差異圖。"

msgid "The images use different sample models or bit depths, so no difference map is shown."
msgstr "兩張影像的樣本模型或位元深度不同，因此不顯示差異圖。"

msgid "Image Analysis Tool checks whether a converted image keeps every sample, colour signal and piece of metadata of the original."
msgstr "Image Analysis Tool 檢查轉換後的影像是否完整保留原檔的每個樣本、色彩訊號與中繼資料。"

msgid "Licensed under the MIT License. Reports are never overwritten; input files are opened read-only."
msgstr "以 MIT 授權條款釋出。報告絕不覆寫，輸入檔一律以唯讀開啟。"

